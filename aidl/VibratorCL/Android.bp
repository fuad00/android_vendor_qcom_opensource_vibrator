COMMON_CFLAGS = ["-Wall"]
COMMON_CFLAGS += ["-Werror"]

cc_library_shared {
    name: "vendor.qti.hardware.vibratorCL.impl",
    cflags: COMMON_CFLAGS,
    vendor: true,
    srcs: ["Vibrator.cpp"],
    header_libs: [
        "//hardware/qcom-caf/sm8750/audio/pal:libspf-headers",
        "//hardware/qcom-caf/sm8750/audio/pal:libarosal_headers",
        "//hardware/qcom-caf/sm8750/audio/pal:libarpal_headers",
    ],

    shared_libs: [
        "android.hardware.vibrator-V2-ndk",
        "libbinder_ndk",
        "liblog",
        "//hardware/qcom-caf/sm8750/audio/pal:libpalclient",
    ],
}